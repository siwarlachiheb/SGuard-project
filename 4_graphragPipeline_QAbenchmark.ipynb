   "metadata": {},
   "source": [
    "# OMIn GraphRAG : Retrieval Pipeline & Benchmark\n",
    "\n",
    "**Goal:** Build the full end-to-end GraphRAG pipeline:\n",
    "1. Domain filter ==> reject out-of-domain queries immediately\n",
    "2. Query embedding ==> find relevant seed nodes\n",
    "3. Subgraph expansion ==> m-hop neighborhood\n",
    "4. Semantic edge scoring ==> cosine relevance (no MST, no uniform weights)\n",
    "5. Record retrieval ==> follow record_id pointers to raw text\n",
    "6. Answer generation ==> Gemini with retrieved context\n",
    "7. Full retrieval trace ==> every decision logged for guardrail + attribution\n",
    "\n",
    "**Also:** Build the QA benchmark with 4 question types:\n",
    "- In-domain answerable\n",
    "- In-domain unanswerable (graph doesn't contain answer)\n",
    "- Out-of-domain\n",
    "- Edge cases (ambiguous, multi-hop)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Setup and load all artifacts"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "!pip install -q google-genai networkx numpy scikit-learn tqdm"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import json, os, time\n",
    "import numpy as np\n",
    "import networkx as nx\n",
    "from collections import defaultdict\n",
    "from tqdm.notebook import tqdm\n",
    "from google import genai\n",
    "\n",
    "GEMINI_API_KEY   = \""\n",
    "client           = genai.Client(api_key=GEMINI_API_KEY)\n",
    "GENERATION_MODEL = \"gemini-2.5-flash\"\n",
    "EMBEDDING_MODEL  = \"gemini-embedding-001\"\n",
    "\n",
    "os.makedirs(\"./output\", exist_ok=True)\n",
    "\n",
    "# Load graph (JSON version — no embeddings, fast to load)\n",
    "with open(\"./output/knowledge_graph.json\") as f:\n",
    "    graph_json = json.load(f)\n",
    "\n",
    "# Load canonical embeddings (entity -> vector)\n",
    "with open(\"./output/canonical_embeddings.json\") as f:\n",
    "    entity_embeddings = json.load(f)\n",
    "\n",
    "# Load relation embeddings\n",
    "with open(\"./output/relation_embeddings.json\") as f:\n",
    "    relation_embeddings = json.load(f)\n",
    "\n",
    "# Load records (document store)\n",
    "with open(\"./output/records.json\") as f:\n",
    "    records = json.load(f)\n",
    "record_lookup = {r[\"record_id\"]: r for r in records}\n",
    "\n",
    "# Load graph schema (for guardrail later)\n",
    "with open(\"./output/graph_schema.json\") as f:\n",
    "    graph_schema = json.load(f)\n",
    "\n",
    "# Rebuild NetworkX graph from JSON\n",
    "G = nx.MultiDiGraph()\n",
    "for node in graph_json[\"nodes\"]:\n",
    "    G.add_node(node[\"id\"],\n",
    "               record_ids=node[\"record_ids\"],\n",
    "               frequency=node[\"frequency\"])\n",
    "for edge in graph_json[\"edges\"]:\n",
    "    G.add_edge(edge[\"head\"], edge[\"tail\"],\n",
    "               relation=edge[\"relation\"],\n",
    "               weight=edge[\"weight\"],\n",
    "               record_ids=edge[\"record_ids\"],\n",
    "               support_count=edge[\"support_count\"])\n",
    "\n",
    "# Build entity embedding matrix for fast similarity search\n",
    "entity_list = list(entity_embeddings.keys())\n",
    "entity_matrix = np.array([entity_embeddings[e] for e in entity_list], dtype=np.float32)\n",
    "# Normalize for cosine similarity\n",
    "norms = np.linalg.norm(entity_matrix, axis=1, keepdims=True)\n",
    "entity_matrix_norm = entity_matrix / (norms + 1e-9)\n",
    "entity_to_idx = {e: i for i, e in enumerate(entity_list)}\n",
    "\n",
    "print(f\"Graph loaded: {G.number_of_nodes()} nodes, {G.number_of_edges()} edges\")\n",
    "print(f\"Records loaded: {len(records)}\")\n",
    "print(f\"Entity embeddings: {len(entity_embeddings)}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Domain filter ==> reject out-of-domain queries"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "DOMAIN_FILTER_PROMPT = \"\"\"You are a domain classifier for an aviation maintenance knowledge system.\n",
    "The system only answers questions about:\n",
    "- Aircraft maintenance procedures and actions\n",
    "- Aviation component failures and causes\n",
    "- Aircraft incident reports and safety\n",
    "- Aviation terminology and systems\n",
    "\n",
    "Classify the following query as IN_DOMAIN or OUT_OF_DOMAIN.\n",
    "Also classify as ANSWERABLE or UNANSWERABLE if in-domain\n",
    "(unanswerable = question about very specific details unlikely to be in a maintenance record database).\n",
    "\n",
    "Query: \"{query}\"\n",
    "\n",
    "Respond with ONLY a JSON object in this exact format:\n",
    "{{\"domain\": \"IN_DOMAIN\" or \"OUT_OF_DOMAIN\", \"answerable\": \"LIKELY\" or \"UNLIKELY\", \"reason\": \"one sentence\"}}\"\"\"\n",
    "\n",
    "def check_domain(query, client):\n",
    "    \"\"\"\n",
    "    Returns dict: {domain, answerable, reason}\n",
    "    domain: IN_DOMAIN or OUT_OF_DOMAIN\n",
    "    answerable: LIKELY or UNLIKELY\n",
    "    \"\"\"\n",
    "    prompt = DOMAIN_FILTER_PROMPT.format(query=query)\n",
    "    try:\n",
    "        response = client.models.generate_content(\n",
    "            model=GENERATION_MODEL,\n",
    "            contents=prompt,\n",
    "            config={\"temperature\": 0.0}\n",
    "        )\n",
    "        raw = response.text.strip()\n",
    "        # Strip markdown code blocks if present\n",
    "        raw = raw.replace(\"```json\", \"\").replace(\"```\", \"\").strip()\n",
    "        result = json.loads(raw)\n",
    "        return result\n",
    "    except Exception as e:\n",
    "        print(f\"Domain filter error: {e}\")\n",
    "        return {\"domain\": \"IN_DOMAIN\", \"answerable\": \"LIKELY\", \"reason\": \"filter failed, defaulting to in-domain\"}\n",
    "\n",
    "# Test domain filter\n",
    "test_queries = [\n",
    "    \"What causes hydraulic leaks in landing gear?\",           # in-domain\n",
    "    \"What is the capital of France?\",                         # out-of-domain\n",
    "    \"How do I cook pasta?\",                                   # out-of-domain\n",
    "    \"What action should be taken for engine power loss?\",     # in-domain\n",
    "    \"Who won the 2024 US election?\",                          # out-of-domain\n",
    "    \"What is the specific serial number of tail N12345?\",     # in-domain but unanswerable\n",
    "]\n",
    "\n",
    "print(\"=== DOMAIN FILTER TEST ===\")\n",
    "for q in test_queries:\n",
    "    result = check_domain(q, client)\n",
    "    print(f\"Q: {q}\")\n",
    "    print(f\"   → {result['domain']} | {result['answerable']} | {result['reason']}\")\n",
    "    print()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Query embedding and top-k seed node retrieval"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def embed_query(query, client, model=EMBEDDING_MODEL):\n",
    "    \"\"\"Embed a query string using Gemini embedding model.\"\"\"\n",
    "    result = client.models.embed_content(model=model, contents=[query])\n",
    "    emb = np.array(result.embeddings[0].values, dtype=np.float32)\n",
    "    emb = emb / (np.linalg.norm(emb) + 1e-9)\n",
    "    return emb\n",
    "def find_seed_nodes(query_emb, entity_matrix_norm, entity_list, G,\n",
    "                    top_k=10, diversity_lambda=0.5):\n",
    "    \"\"\"\n",
    "    Find top-k diverse graph nodes using Maximal Marginal Relevance (MMR).\n",
    "    diversity_lambda: 0=max diversity, 1=max relevance, 0.5=balanced\n",
    "    \"\"\"\n",
    "    # Compute all similarities to query\n",
    "    similarities = entity_matrix_norm @ query_emb\n",
    "\n",
    "    # Filter to nodes that exist in graph\n",
    "    seeds = [\n",
    "        (entity_list[i], float(similarities[i]))\n",
    "        for i in range(len(entity_list))\n",
    "        if entity_list[i] in G.nodes\n",
    "    ]\n",
    "    seeds.sort(key=lambda x: -x[1])\n",
    "    seeds = seeds[:200]  # pre-filter top 200\n",
    "\n",
    "    selected      = []\n",
    "    selected_embs = []\n",
    "\n",
    "    while len(selected) < top_k and seeds:\n",
    "        best_score = -999\n",
    "        best_idx   = 0\n",
    "\n",
    "        for i, (entity, sim_to_query) in enumerate(seeds):\n",
    "            if not selected_embs:\n",
    "                mmr_score = sim_to_query\n",
    "            else:\n",
    "                # Max similarity to any already-selected node\n",
    "                entity_emb = entity_matrix_norm[entity_list.index(entity)]\n",
    "                max_sim_to_selected = max(\n",
    "                    float(np.dot(entity_emb, s_emb))\n",
    "                    for s_emb in selected_embs\n",
    "                )\n",
    "                mmr_score = (diversity_lambda * sim_to_query\n",
    "                             - (1 - diversity_lambda) * max_sim_to_selected)\n",
    "\n",
    "            if mmr_score > best_score:\n",
    "                best_score = mmr_score\n",
    "                best_idx   = i\n",
    "\n",
    "        entity, sim = seeds.pop(best_idx)\n",
    "        entity_emb = entity_matrix_norm[entity_to_idx[entity]]\n",
    "        selected.append({\"node\": entity, \"similarity\": sim, \"mmr_score\": best_score})\n",
    "        selected_embs.append(entity_emb)\n",
    "\n",
    "    return selected\n",
    "\n",
    "# Test\n",
    "test_query = \"What causes hydraulic leaks in landing gear?\"\n",
    "query_emb  = embed_query(test_query, client)\n",
    "seed_nodes = find_seed_nodes(query_emb, entity_matrix_norm, entity_list, G,\n",
    "                              top_k=10, diversity_lambda=0.5)\n",
    "seeds = seed_nodes  # alias for cell 4\n",
    "\n",
    "print(f\"Query: {test_query}\")\n",
    "print(\"Top-10 seed nodes (MMR):\")\n",
    "for s in seed_nodes:\n",
    "    print(f\"  {s['node']:<40} sim={s['similarity']:.4f}  mmr={s['mmr_score']:.4f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Subgraph expansion and semantic edge scoring"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def expand_subgraph(seed_nodes, G, hops=2):\n",
    "    \"\"\"\n",
    "    Expand m-hop neighborhood around seed nodes.\n",
    "    Returns subgraph as list of edges with all attributes.\n",
    "    \"\"\"\n",
    "    visited = set(s[\"node\"] for s in seed_nodes)\n",
    "    frontier = set(visited)\n",
    "\n",
    "    for _ in range(hops):\n",
    "        new_frontier = set()\n",
    "        for node in frontier:\n",
    "            if node not in G:\n",
    "                continue\n",
    "            # Both directions for undirected expansion\n",
    "            for neighbor in list(G.successors(node)) + list(G.predecessors(node)):\n",
    "                if neighbor not in visited:\n",
    "                    new_frontier.add(neighbor)\n",
    "                    visited.add(neighbor)\n",
    "        frontier = new_frontier\n",
    "\n",
    "    # Collect all edges within the expanded node set\n",
    "    subgraph_edges = []\n",
    "    for u, v, data in G.edges(data=True):\n",
    "        if u in visited and v in visited:\n",
    "            subgraph_edges.append({\n",
    "                \"head\": u, \"tail\": v,\n",
    "                \"relation\": data[\"relation\"],\n",
    "                \"record_ids\": data[\"record_ids\"],\n",
    "                \"support_count\": data[\"support_count\"]\n",
    "            })\n",
    "\n",
    "    return subgraph_edges, visited\n",
    "\n",
    "\n",
    "def score_edges_semantic(subgraph_edges, query_emb, entity_embeddings,\n",
    "                          relation_embeddings, top_n=30):\n",
    "    \"\"\"\n",
    "    Score each edge by semantic relevance to query.\n",
    "    Score = weighted combination of:\n",
    "      - cosine(query, head_entity)\n",
    "      - cosine(query, tail_entity)\n",
    "      - cosine(query, relation_description)\n",
    "    Returns top-N edges sorted by score.\n",
    "    \"\"\"\n",
    "    scored = []\n",
    "    for edge in subgraph_edges:\n",
    "        head_emb = entity_embeddings.get(edge[\"head\"])\n",
    "        tail_emb = entity_embeddings.get(edge[\"tail\"])\n",
    "        rel_emb  = relation_embeddings.get(edge[\"relation\"])\n",
    "\n",
    "        if head_emb is None or tail_emb is None or rel_emb is None:\n",
    "            continue\n",
    "\n",
    "        head_emb = np.array(head_emb, dtype=np.float32)\n",
    "        tail_emb = np.array(tail_emb, dtype=np.float32)\n",
    "        rel_emb  = np.array(rel_emb,  dtype=np.float32)\n",
    "\n",
    "        # Normalize\n",
    "        head_emb = head_emb / (np.linalg.norm(head_emb) + 1e-9)\n",
    "        tail_emb = tail_emb / (np.linalg.norm(tail_emb) + 1e-9)\n",
    "        rel_emb  = rel_emb  / (np.linalg.norm(rel_emb)  + 1e-9)\n",
    "\n",
    "        # Weighted cosine scores\n",
    "        sim_head = float(np.dot(query_emb, head_emb))\n",
    "        sim_tail = float(np.dot(query_emb, tail_emb))\n",
    "        sim_rel  = float(np.dot(query_emb, rel_emb))\n",
    "\n",
    "        # Head and tail weighted equally, relation slightly less\n",
    "        score = 0.4 * sim_head + 0.4 * sim_tail + 0.2 * sim_rel\n",
    "\n",
    "        scored.append({**edge, \"relevance_score\": score})\n",
    "\n",
    "    # Sort by relevance, take top-N\n",
    "    scored.sort(key=lambda x: -x[\"relevance_score\"])\n",
    "    return scored[:top_n]\n",
    "\n",
    "seeds = seed_nodes\n",
    "# Test\n",
    "subgraph_edges, visited_nodes = expand_subgraph(seeds, G, hops=2)\n",
    "scored_edges = score_edges_semantic(subgraph_edges, query_emb,\n",
    "                                     entity_embeddings, relation_embeddings, top_n=30)\n",
    "\n",
    "print(f\"Expanded subgraph: {len(visited_nodes)} nodes, {len(subgraph_edges)} edges\")\n",
    "print(f\"After semantic scoring (top 30):\")\n",
    "for e in scored_edges[:10]:\n",
    "    print(f\"  [{e['relevance_score']:.3f}] {e['head']} | {e['relation']} | {e['tail']}\")\n",
    "    print(f\"           supported by {e['support_count']} records\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Record retrieval — follow pointers to raw text"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def retrieve_records(scored_edges, record_lookup, max_records=15):\n",
    "    \"\"\"\n",
    "    Collect unique record_ids from top-scored edges.\n",
    "    Returns list of records sorted by how many top edges reference them.\n",
    "    record_id -> score contribution (sum of edge relevance scores)\n",
    "    \"\"\"\n",
    "    record_scores = defaultdict(float)\n",
    "    record_edge_map = defaultdict(list)  # record_id -> edges that reference it\n",
    "\n",
    "    for edge in scored_edges:\n",
    "        for rid in edge[\"record_ids\"]:\n",
    "            record_scores[rid] += edge[\"relevance_score\"]\n",
    "            record_edge_map[rid].append({\n",
    "                \"head\": edge[\"head\"],\n",
    "                \"relation\": edge[\"relation\"],\n",
    "                \"tail\": edge[\"tail\"],\n",
    "                \"score\": edge[\"relevance_score\"]\n",
    "            })\n",
    "\n",
    "    # Sort records by cumulative relevance score\n",
    "    sorted_records = sorted(record_scores.items(), key=lambda x: -x[1])\n",
    "    top_record_ids = [rid for rid, _ in sorted_records[:max_records]]\n",
    "\n",
    "    retrieved = []\n",
    "    for rid in top_record_ids:\n",
    "        if rid in record_lookup:\n",
    "            rec = record_lookup[rid]\n",
    "            retrieved.append({\n",
    "                \"record_id\": rid,\n",
    "                \"source_file\": rec[\"source_file\"],\n",
    "                \"source_row\": rec.get(\"source_row\", \"unknown\"),\n",
    "                \"text\": rec[\"text_original\"],\n",
    "                \"relevance_score\": record_scores[rid],\n",
    "                \"supporting_edges\": record_edge_map[rid][:3]  # top 3 edges\n",
    "            })\n",
    "\n",
    "    return retrieved\n",
    "\n",
    "\n",
    "# Test\n",
    "retrieved_records = retrieve_records(scored_edges, record_lookup, max_records=15)\n",
    "\n",
    "print(f\"Retrieved {len(retrieved_records)} records\")\n",
    "print(\"\\nTop 5 retrieved records:\")\n",
    "for rec in retrieved_records[:5]:\n",
    "    print(f\"\\n  [{rec['relevance_score']:.3f}] {rec['record_id']}\")\n",
    "    print(f\"  Source: {rec['source_file']} row {rec['source_row']}\")\n",
    "    print(f\"  Text: {rec['text'][:150]}\")\n",
    "    print(f\"  Via edges: {[(e['head'], e['relation'], e['tail']) for e in rec['supporting_edges']]}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Answer generation with full context and source attribution"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "GENERATION_PROMPT = \"\"\"You are an aviation maintenance expert assistant.\n",
    "Answer the question based ONLY on the provided maintenance records.\n",
    "If the records do not contain sufficient information to answer, say so explicitly.\n",
    "\n",
    "QUESTION: {query}\n",
    "\n",
    "RETRIEVED MAINTENANCE RECORDS:\n",
    "{context}\n",
    "\n",
    "INSTRUCTIONS:\n",
    "- Answer based only on the provided records\n",
    "- Be specific and cite which records support your answer\n",
    "- If records are insufficient, state: \"The available records do not contain enough information to answer this question.\"\n",
    "- Do not hallucinate information not present in the records\n",
    "\n",
    "ANSWER:\"\"\"\n",
    "\n",
    "def format_context(retrieved_records):\n",
    "    \"\"\"Format retrieved records as numbered context for the LLM.\"\"\"\n",
    "    lines = []\n",
    "    for i, rec in enumerate(retrieved_records, 1):\n",
    "        lines.append(f\"[Record {i} | {rec['record_id']} | {rec['source_file']}]\")\n",
    "        lines.append(rec['text'])\n",
    "        lines.append(\"\")\n",
    "    return \"\\n\".join(lines)\n",
    "\n",
    "\n",
    "def generate_answer(query, retrieved_records, client):\n",
    "    \"\"\"Generate answer from retrieved records.\"\"\"\n",
    "    if not retrieved_records:\n",
    "        return \"No relevant records found in the aviation maintenance database for this query.\"\n",
    "\n",
    "    context = format_context(retrieved_records)\n",
    "    prompt  = GENERATION_PROMPT.format(query=query, context=context)\n",
    "\n",
    "    response = client.models.generate_content(\n",
    "        model=GENERATION_MODEL,\n",
    "        contents=prompt,\n",
    "        config={\"temperature\": 0.2}\n",
    "    )\n",
    "    return response.text.strip()\n",
    "\n",
    "\n",
    "# Test full pipeline\n",
    "answer = generate_answer(test_query, retrieved_records, client)\n",
    "print(f\"Q: {test_query}\")\n",
    "print(f\"\\nA: {answer}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Full pipeline function with complete trace"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def graphrag_query(query, client, G, entity_matrix_norm, entity_list,\n",
    "                   entity_embeddings, relation_embeddings, record_lookup,\n",
    "                   top_k_seeds=10, hops=2, top_n_edges=30, max_records=15):\n",
    "    \"\"\"\n",
    "    Full GraphRAG pipeline with complete retrieval trace.\n",
    "\n",
    "    Returns:\n",
    "        answer: str\n",
    "        trace: dict with every step logged for guardrail + attribution\n",
    "    \"\"\"\n",
    "    trace = {\"query\": query, \"steps\": {}}\n",
    "\n",
    "    # Step 1: Domain filter\n",
    "    domain_check = check_domain(query, client)\n",
    "    trace[\"steps\"][\"domain_filter\"] = domain_check\n",
    "\n",
    "    if domain_check[\"domain\"] == \"OUT_OF_DOMAIN\":\n",
    "        return (\n",
    "            f\"This question is outside the scope of the aviation maintenance database. \"\n",
    "            f\"Reason: {domain_check['reason']}\",\n",
    "            trace\n",
    "        )\n",
    "\n",
    "    # Step 2: Embed query\n",
    "    query_emb = embed_query(query, client)\n",
    "    trace[\"steps\"][\"query_embedding\"] = {\"dimension\": len(query_emb)}\n",
    "\n",
    "    # Step 3: Find seed nodes\n",
    "    seed_nodes = find_seed_nodes(query_emb, entity_matrix_norm,\n",
    "                                  entity_list, G, top_k=top_k_seeds)\n",
    "    trace[\"steps\"][\"seed_nodes\"] = seed_nodes\n",
    "\n",
    "    if not seed_nodes:\n",
    "        return \"No relevant entities found in the knowledge graph for this query.\", trace\n",
    "\n",
    "    # Step 4: Expand subgraph\n",
    "    subgraph_edges, visited_nodes = expand_subgraph(seed_nodes, G, hops=hops)\n",
    "    trace[\"steps\"][\"subgraph_expansion\"] = {\n",
    "        \"nodes_visited\": len(visited_nodes),\n",
    "        \"edges_found\": len(subgraph_edges),\n",
    "        \"hops\": hops\n",
    "    }\n",
    "\n",
    "    # Step 5: Score edges semantically\n",
    "    scored_edges = score_edges_semantic(\n",
    "        subgraph_edges, query_emb, entity_embeddings,\n",
    "        relation_embeddings, top_n=top_n_edges\n",
    "    )\n",
    "    trace[\"steps\"][\"scored_edges\"] = [\n",
    "        {\"head\": e[\"head\"], \"relation\": e[\"relation\"],\n",
    "         \"tail\": e[\"tail\"], \"score\": e[\"relevance_score\"]}\n",
    "        for e in scored_edges[:10]  # log top 10\n",
    "    ]\n",
    "\n",
    "    # Step 6: Retrieve records\n",
    "    retrieved_records = retrieve_records(scored_edges, record_lookup,\n",
    "                                          max_records=max_records)\n",
    "    trace[\"steps\"][\"retrieved_records\"] = [\n",
    "        {\"record_id\": r[\"record_id\"],\n",
    "         \"source_file\": r[\"source_file\"],\n",
    "         \"source_row\": r[\"source_row\"],\n",
    "         \"relevance_score\": r[\"relevance_score\"],\n",
    "         \"supporting_edges\": r[\"supporting_edges\"]}\n",
    "        for r in retrieved_records\n",
    "    ]\n",
    "\n",
    "    # Low confidence signal: if top record score is very low\n",
    "    if retrieved_records and retrieved_records[0][\"relevance_score\"] < 0.3:\n",
    "        trace[\"steps\"][\"low_confidence\"] = True\n",
    "    else:\n",
    "        trace[\"steps\"][\"low_confidence\"] = False\n",
    "\n",
    "    # Step 7: Generate answer\n",
    "    if not retrieved_records or trace[\"steps\"][\"low_confidence\"]:\n",
    "        if domain_check[\"answerable\"] == \"UNLIKELY\":\n",
    "            answer = (\n",
    "                \"This question is within the aviation maintenance domain but the database \"\n",
    "                \"does not contain sufficient specific information to answer it. \"\n",
    "                f\"Searched: {[s['node'] for s in seed_nodes[:5]]}\"\n",
    "            )\n",
    "            trace[\"steps\"][\"abstained\"] = True\n",
    "            return answer, trace\n",
    "\n",
    "    answer = generate_answer(query, retrieved_records, client)\n",
    "    trace[\"steps\"][\"abstained\"] = False\n",
    "\n",
    "    return answer, trace\n",
    "\n",
    "\n",
    "# Full pipeline test\n",
    "print(\"=== FULL PIPELINE TEST ===\")\n",
    "answer, trace = graphrag_query(\n",
    "    \"What causes hydraulic leaks in landing gear?\",\n",
    "    client, G, entity_matrix_norm, entity_list,\n",
    "    entity_embeddings, relation_embeddings, record_lookup\n",
    ")\n",
    "print(f\"Answer: {answer}\")\n",
    "print(f\"\\nTrace summary:\")\n",
    "print(f\"  Domain: {trace['steps']['domain_filter']['domain']}\")\n",
    "print(f\"  Seed nodes: {[s['node'] for s in trace['steps']['seed_nodes'][:5]]}\")\n",
    "print(f\"  Subgraph: {trace['steps']['subgraph_expansion']['nodes_visited']} nodes, {trace['steps']['subgraph_expansion']['edges_found']} edges\")\n",
    "print(f\"  Records retrieved: {len(trace['steps']['retrieved_records'])}\")\n",
    "print(f\"  Abstained: {trace['steps']['abstained']}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Build QA benchmark 4 question types"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# QA Benchmark — manually curated + auto-generated\n",
    "# 4 types: in-domain answerable, in-domain unanswerable,\n",
    "#          out-of-domain, multi-hop\n",
    "\n",
    "QA_BENCHMARK = {\n",
    "    \"in_domain_answerable\": [\n",
    "        {\"question\": \"What are the most common causes of engine failure in aircraft?\",\n",
    "         \"expected_contains\": [\"fuel\", \"cylinder\", \"oil\", \"ignition\"],\n",
    "         \"difficulty\": \"easy\"},\n",
    "        {\"question\": \"What action should be taken when a hydraulic leak is found in the landing gear?\",\n",
    "         \"expected_contains\": [\"inspect\", \"replace\", \"seal\", \"repair\"],\n",
    "         \"difficulty\": \"easy\"},\n",
    "        {\"question\": \"What components are most frequently replaced during engine maintenance?\",\n",
    "         \"expected_contains\": [\"gasket\", \"seal\", \"spark plug\", \"filter\"],\n",
    "         \"difficulty\": \"medium\"},\n",
    "        {\"question\": \"How do carburetor problems typically affect aircraft performance?\",\n",
    "         \"expected_contains\": [\"engine\", \"fuel\", \"power\", \"failure\"],\n",
    "         \"difficulty\": \"medium\"},\n",
    "        {\"question\": \"What are the common causes of oil leaks in aircraft engines?\",\n",
    "         \"expected_contains\": [\"gasket\", \"seal\", \"pressure\", \"crack\"],\n",
    "         \"difficulty\": \"easy\"},\n",
    "        {\"question\": \"What maintenance actions are typically required after a hard landing?\",\n",
    "         \"expected_contains\": [\"inspect\", \"gear\", \"structure\", \"check\"],\n",
    "         \"difficulty\": \"medium\"},\n",
    "        {\"question\": \"What causes fuel system failures during flight?\",\n",
    "         \"expected_contains\": [\"pump\", \"valve\", \"leak\", \"blockage\"],\n",
    "         \"difficulty\": \"medium\"},\n",
    "        {\"question\": \"What are signs of magneto failure in aircraft engines?\",\n",
    "         \"expected_contains\": [\"ignition\", \"engine\", \"rpm\", \"rough\"],\n",
    "         \"difficulty\": \"medium\"},\n",
    "    ],\n",
    "    \"in_domain_unanswerable\": [\n",
    "        {\"question\": \"What is the exact maintenance schedule for tail number N12345?\",\n",
    "         \"reason\": \"Specific tail number not in database\",\n",
    "         \"expected_behavior\": \"abstain\"},\n",
    "        {\"question\": \"What did technician John Smith do on March 15 1995?\",\n",
    "         \"reason\": \"Specific person and date not queryable\",\n",
    "         \"expected_behavior\": \"abstain\"},\n",
    "        {\"question\": \"What is the exact torque specification for the main rotor bolt?\",\n",
    "         \"reason\": \"Precise engineering specs not in incident records\",\n",
    "         \"expected_behavior\": \"abstain\"},\n",
    "        {\"question\": \"How many total flight hours did aircraft N98765 accumulate before failure?\",\n",
    "         \"reason\": \"Flight hour tracking not in database\",\n",
    "         \"expected_behavior\": \"abstain\"},\n",
    "    ],\n",
    "    \"out_of_domain\": [\n",
    "        {\"question\": \"What is the capital of France?\",\n",
    "         \"expected_behavior\": \"reject\"},\n",
    "        {\"question\": \"How do I make chocolate cake?\",\n",
    "         \"expected_behavior\": \"reject\"},\n",
    "        {\"question\": \"Who won the 2024 US presidential election?\",\n",
    "         \"expected_behavior\": \"reject\"},\n",
    "        {\"question\": \"What is the current stock price of Boeing?\",\n",
    "         \"expected_behavior\": \"reject\"},\n",
    "        {\"question\": \"Write me a poem about aviation.\",\n",
    "         \"expected_behavior\": \"reject\"},\n",
    "    ],\n",
    "    \"multi_hop\": [\n",
    "        {\"question\": \"What component failures most commonly lead to emergency landings, and what are the typical repair actions?\",\n",
    "         \"expected_contains\": [\"engine\", \"landing\", \"repair\", \"replace\"],\n",
    "         \"difficulty\": \"hard\",\n",
    "         \"note\": \"Requires connecting failure -> emergency landing -> repair action\"},\n",
    "        {\"question\": \"How do fuel system problems affect takeoff safety and what preventive maintenance is recommended?\",\n",
    "         \"expected_contains\": [\"fuel\", \"takeoff\", \"inspect\", \"pump\"],\n",
    "         \"difficulty\": \"hard\",\n",
    "         \"note\": \"Multi-hop: fuel system -> takeoff failure -> prevention\"},\n",
    "        {\"question\": \"What is the relationship between cylinder problems and engine power loss during critical flight phases?\",\n",
    "         \"expected_contains\": [\"cylinder\", \"power\", \"engine\", \"compression\"],\n",
    "         \"difficulty\": \"hard\",\n",
    "         \"note\": \"Requires linking cylinder -> power loss -> flight phase\"},\n",
    "    ]\n",
    "}\n",
    "\n",
    "# Save benchmark\n",
    "with open(\"./output/qa_benchmark.json\", \"w\") as f:\n",
    "    json.dump(QA_BENCHMARK, f, indent=2)\n",
    "\n",
    "total = sum(len(v) for v in QA_BENCHMARK.values())\n",
    "print(\"=== QA BENCHMARK ===\")\n",
    "for qtype, questions in QA_BENCHMARK.items():\n",
    "    print(f\"  {qtype:<30} {len(questions)} questions\")\n",
    "print(f\"  {'TOTAL':<30} {total} questions\")\n",
    "print(\"\\nSaved to ./output/qa_benchmark.json\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Run full benchmark evaluation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def evaluate_pipeline(benchmark, client, G, entity_matrix_norm, entity_list,\n",
    "                       entity_embeddings, relation_embeddings, record_lookup):\n",
    "    \"\"\"\n",
    "    Run all benchmark questions through the pipeline.\n",
    "    Track: correct domain classification, correct abstention,\n",
    "           answer quality indicators, retrieval stats.\n",
    "    \"\"\"\n",
    "    results = {}\n",
    "\n",
    "    for qtype, questions in benchmark.items():\n",
    "        results[qtype] = []\n",
    "        print(f\"\\n=== {qtype.upper()} ({len(questions)} questions) ===\")\n",
    "\n",
    "        for q_data in tqdm(questions, desc=qtype):\n",
    "            query = q_data[\"question\"]\n",
    "            answer, trace = graphrag_query(\n",
    "                query, client, G, entity_matrix_norm, entity_list,\n",
    "                entity_embeddings, relation_embeddings, record_lookup\n",
    "            )\n",
    "\n",
    "            result = {\n",
    "                \"question\": query,\n",
    "                \"answer\": answer,\n",
    "                \"trace\": trace,\n",
    "                \"domain_detected\": trace[\"steps\"][\"domain_filter\"][\"domain\"],\n",
    "                \"abstained\": trace[\"steps\"].get(\"abstained\", False),\n",
    "                \"records_retrieved\": len(trace[\"steps\"].get(\"retrieved_records\", [])),\n",
    "                \"seed_nodes\": [s[\"node\"] for s in trace[\"steps\"].get(\"seed_nodes\", [])[:5]],\n",
    "            }\n",
    "\n",
    "            # Domain classification correctness\n",
    "            if qtype == \"out_of_domain\":\n",
    "                result[\"domain_correct\"] = (result[\"domain_detected\"] == \"OUT_OF_DOMAIN\")\n",
    "            else:\n",
    "                result[\"domain_correct\"] = (result[\"domain_detected\"] == \"IN_DOMAIN\")\n",
    "\n",
    "            # Abstention correctness\n",
    "            if qtype == \"in_domain_unanswerable\":\n",
    "                result[\"abstention_correct\"] = result[\"abstained\"]\n",
    "            elif qtype == \"out_of_domain\":\n",
    "                result[\"abstention_correct\"] = result[\"domain_detected\"] == \"OUT_OF_DOMAIN\"\n",
    "            else:\n",
    "                result[\"abstention_correct\"] = not result[\"abstained\"]\n",
    "\n",
    "            results[qtype].append(result)\n",
    "            time.sleep(1)  # rate limit\n",
    "\n",
    "    return results\n",
    "\n",
    "\n",
    "print(\"Running full benchmark evaluation...\")\n",
    "print(\"This will take ~5-10 minutes for all questions.\")\n",
    "eval_results = evaluate_pipeline(\n",
    "    QA_BENCHMARK, client, G, entity_matrix_norm, entity_list,\n",
    "    entity_embeddings, relation_embeddings, record_lookup\n",
    ")\n",
    "\n",
    "with open(\"./output/eval_results_baseline.json\", \"w\") as f:\n",
    "    json.dump(eval_results, f, indent=2, default=str)\n",
    "\n",
    "print(\"\\nResults saved to ./output/eval_results_baseline.json\")"
   ]
  },
